# Committed defaults for the Base44 sandbox stack (see docker-compose.base44.yml).
# Real credentials are delivered by the platform at /run/base44/app.env, which is
# listed AFTER this file in the compose env_file chain, so dashboard values win.
#
# Telegram bot token from @BotFather. Empty here on purpose: the app boots and
# serves its JSON endpoints without it and only logs a warning.
BOT_TOKEN=
# Shared secret for the Telegram webhook (X-Telegram-Bot-Api-Secret-Token header).
# The Base44 dashboard holds the generated development value for this key.
WEBHOOK_SECRET=
# Optional SerpAPI key for online price lookups; empty disables that enrichment.
SERPAPI_API_KEY=
